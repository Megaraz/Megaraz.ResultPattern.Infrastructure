<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Megaraz.ResultPattern.Infrastructure</PackageId>
    <Version>0.1.0</Version>
    <Title>Megaraz Result Pattern Infrastructure</Title>
    <Description>Provider-neutral infrastructure error extensions for Megaraz.ResultPattern.</Description>
    <Authors>Megaraz</Authors>
    <Copyright>Copyright (c) 2026 Megaraz</Copyright>
    <RepositoryUrl>https://github.com/Megaraz/Megaraz.ResultPattern.Infrastructure</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Megaraz/Megaraz.ResultPattern.Infrastructure</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>result;result-pattern;errors;infrastructure;database</PackageTags>
    <PackageReleaseNotes>0.1.0: Initial public release of provider-neutral infrastructure error extensions, with verified release artifacts, portable symbols, Source Link validation, and a minimum Megaraz.ResultPattern dependency of 0.2.2.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Megaraz.ResultPattern" Version="0.2.2" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
